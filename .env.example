# Copy to .env and fill in. Only these three are required; everything
# below has a working default in internal/app/config.go.
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_WEBHOOK_SECRET=replace-with-a-long-random-value
PANDASCORE_TOKEN=replace-me

# Password for the development database in docker/compose.yml, used both
# by the postgres container and by the bot connecting to it. Leave it
# unset and both sides fall back to "cs2predictor". In production set a strong password
# in the server .env instead, see ansible/README.md.
# POSTGRES_PASSWORD=cs2predictor

# Comma-separated Telegram numeric ids that are always allowed to use
# /team_matches (the Valve VRS team-identity review queue) and to appoint
# more reviewers via /team_match_admin — see README.md. Also used, outside
# this app entirely, by ansible/roles/notify_admins for deploy-failure DMs.
# Leave unset and the feature simply has no root operators configured.
# DEPLOY_NOTIFY_CHAT_IDS=

# Optional overrides — sensible defaults are set in internal/app/config.go
# PORT=8080
# TELEGRAM_BASE_URL=https://api.telegram.org
# PANDASCORE_BASE_URL=https://api.pandascore.co
# PANDASCORE_PAGE_SIZE=100
# PANDASCORE_EVENT_BATCH_SIZE=50
# Batches of PANDASCORE_EVENT_BATCH_SIZE events fetched in parallel when syncing matches
# PANDASCORE_MAX_CONCURRENCY=4

# Comma-separated, tried in order with automatic fallback to the next provider
# COMPETITION_PROVIDERS_ORDER=PANDASCORE
# COMPETITION_PROVIDERS_HEALTH_STARTUP_GRACE=2m
# COMPETITION_PROVIDERS_HEALTH_MAX_STALENESS=5m
# Consecutive failures before a provider's circuit opens (calls short-circuited without an
# HTTP round trip until the backoff elapses); 0 disables the breaker
# COMPETITION_PROVIDERS_CIRCUIT_BREAKER_THRESHOLD=3
# COMPETITION_PROVIDERS_CIRCUIT_BREAKER_BASE_DELAY=30s
# COMPETITION_PROVIDERS_CIRCUIT_BREAKER_MAX_DELAY=15m

# HTTP client timeouts shared by all outbound API calls (PandaScore, Telegram)
# HTTP_CONNECT_TIMEOUT=5s
# HTTP_READ_TIMEOUT=10s
# HTTP_RESPONSE_TIMEOUT=10s

# Scheduled synchronization cadence, in milliseconds
# SYNC_EVENTS_DELAY_MS=600000
# SYNC_MATCHES_DELAY_MS=60000
# SYNC_POLL_CLOSE_DELAY_MS=5000
# OUTBOX_DELAY_MS=2000
# OUTBOX_BATCH_SIZE=50
# APP_SCHEDULING_ENABLED=true
# Deadline for a single run of any scheduled job (sync, poll-close, outbox dispatch)
# APP_JOB_TIMEOUT=2m

# Opt-in private nudges. Users turn these on themselves in their DM settings; nothing is sent
# to anyone who hasn't. A zero lead disables the pre-close reminder job entirely
# POLL_REMINDER_LEAD=30m
# POLL_REMINDER_CHECK_DELAY=1m
# POLL_REMINDER_PARTICIPANT_WINDOW=1440h

# Token-bucket rate limit on accepted /telegram/webhook requests (defense in depth beyond
# the webhook secret check). 0 disables the limiter
# WEBHOOK_RATE_LIMIT_RPS=20
# WEBHOOK_RATE_LIMIT_BURST=40

# DATABASE_URL=postgresql://localhost:5432/cs2predictor
# DATABASE_USER=cs2predictor
# DATABASE_PASSWORD=cs2predictor
# (docker/compose.yml sets these three for the bot container itself; they matter
# only for `make run` and `go run ./cmd/bot` against a database you started yourself)
# DATABASE_POOL_SIZE=10
# APP_LOG_LEVEL=INFO

# Retention sweep for the tables that grow with traffic rather than with the domain:
# the webhook dedup ledger, published outbox rows, and resolved confirmation requests
# A zero TTL keeps that table forever; a zero interval disables the sweep entirely
# RETENTION_SWEEP_INTERVAL=6h
# RETENTION_PROCESSED_UPDATES_TTL=48h
# RETENTION_PUBLISHED_OUTBOX_TTL=336h
# RETENTION_RESOLVED_REQUESTS_TTL=720h
# RETENTION_ADMIN_ACTIONS_TTL=2160h

# Optional team-data enrichment (PandaScore remains the sole source of truth for
# events/matches/schedule/results — this only ever adds cached, best-effort context like a
# Valve Regional Standings rank line to an outgoing poll)
# VALVE_VRS_ENABLED=true
# VALVE_VRS_SYNC_INTERVAL=6h

# HLTV's own world ranking AND Valve's official ranking (as mirrored on hltv.org), both
# top-100, via the Apify actor paco_nassa~hltv-org-team-ranking
# (https://apify.com/paco_nassa/hltv-org-team-ranking). Requires an Apify account/token
# (https://console.apify.com/settings/integrations). Real fetches happen at most once a
# calendar week per ranking (see internal/app.ApifyRankingGate): on HLTV's own update day
# (Monday) at end of day, or ahead of schedule when a top-tier tournament is running or
# starts within the next 7 days — APIFY_RANKING_CHECK_INTERVAL only controls how often that
# condition is checked, not how often a paid fetch actually happens. At ~$3/1000 results,
# two 100-team fetches a week comfortably fits Apify's $5/month free platform credit. The
# Valve/VRS half feeds the same ranking VALVE_VRS_ENABLED's free GitHub-based feed does —
# that one keeps running independently as the fallback for the rest of the week.
# HLTV_ENABLED=false
# APIFY_TOKEN=
# APIFY_RANKING_CHECK_INTERVAL=1h
# APIFY_MAX_TEAMS=100

# GRID Open Access — recent team form and head-to-head. Requires a free API key requested at
# https://grid.gg/open-access-application-form/. Not verified against the live API in this
# codebase (no key was available while building it) — confirm/adjust internal/adapter/grid
# once you have real access
# GRID_ENABLED=false
# GRID_API_KEY=
# GRID_SYNC_INTERVAL=3h

# Liquipedia (LPDB v3) — richer tournament naming/context. Requires a free API key requested
# at https://liquipedia.net/api (not self-service; educational/non-commercial/community use
# qualifies for a free tier)
# LIQUIPEDIA_ENABLED=false
# LIQUIPEDIA_API_KEY=
# LIQUIPEDIA_SYNC_INTERVAL=24h
